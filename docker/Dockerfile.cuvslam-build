# gcc-8 build environment for porting cuVSLAM's CUDA path to CUDA 10.2 (TX2).
# Ubuntu 18.04 has gcc-8 natively — the host compiler nvcc 10.2 requires.
# CUDA itself is mounted at /usr/local/cuda at runtime (nvidia runtime), same as
# the ROS 2 image. Output libcuvslam.so is consumed by the ROS 2 Jazzy container
# (libstdc++ is forward-compatible, so a gcc-8-built .so links into gcc-13).
FROM ubuntu:18.04
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::ForceIPv4 "true";' \
    > /etc/apt/apt.conf.d/99resilient

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc-8 g++-8 git pkg-config wget ca-certificates \
    libeigen3-dev liblmdb-dev libgtest-dev zlib1g-dev \
    python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# cuVSLAM needs cmake >= 3.19; 18.04 ships 3.10. Use the official aarch64 binary.
RUN wget -qO /tmp/cmake.sh \
      https://github.com/Kitware/CMake/releases/download/v3.27.9/cmake-3.27.9-linux-aarch64.sh && \
    sh /tmp/cmake.sh --skip-license --prefix=/usr/local && rm /tmp/cmake.sh && \
    cmake --version

ENV CUDA_HOME=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:/usr/local/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/targets/aarch64-linux/lib

# L4T puts the real GPU driver (libcuda.so.1) under tegra/. A plain ubuntu base
# lacks this ld config (l4t-base has it), so libcuda.so.1 isn't found at runtime
# and CUDA reports "driver version insufficient". Add the search path; run
# `ldconfig` at container start (after the nvidia runtime mounts the tegra libs)
# for GPU runtime use.
RUN printf '/usr/lib/aarch64-linux-gnu/tegra\n/usr/lib/aarch64-linux-gnu/tegra-egl\n' \
    > /etc/ld.so.conf.d/nvidia-tegra.conf

WORKDIR /workspace
CMD ["bash"]

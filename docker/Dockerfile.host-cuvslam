# Host-side ROS 2 Foxy + cuVSLAM build/run image (x86_64).
#
# Mirrors ackermann_rover_humble's pattern: one GPU-capable container, host CUDA
# bind-mounted at /usr/local/cuda, libcuvslam.so built from source for THIS machine's
# arch — NOT the TX2 CUDA-10.2 port. Bags stay Foxy v4 so TX2 recordings replay here.
#
#   docker build -f docker/Dockerfile.host-cuvslam -t bev-host-cuvslam:latest .
#   # then: scripts/build_cuvslam_host.sh && scripts/vo/replay_host.sh <bag>
#
# Distinct from docker/Dockerfile.host-foxy (DDS viewer only, no CUDA / no VO) and
# from docker/Dockerfile.cuvslam-foxy (TX2 aarch64 / CUDA 10.2 / Argus).
FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::ForceIPv4 "true";' \
    > /etc/apt/apt.conf.d/99resilient

RUN apt-get update && apt-get install -y \
    curl gnupg2 lsb-release locales ca-certificates \
    && locale-gen en_US en_US.UTF-8 && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu focal main" \
    > /etc/apt/sources.list.d/ros2.list

ENV ROS_DISTRO=foxy
ENV ROS_ROOT=/opt/ros/foxy
# gcc-11: Focal's default gcc-9 lacks floating-point std::from_chars (cuVSLAM
# parse_utils.cpp). Same host-compiler choice as ackermann_rover_humble.
RUN apt-get update && apt-get install -y software-properties-common \
    && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
    && apt-get update && apt-get install -y \
    ros-foxy-ros-base \
    ros-foxy-cv-bridge ros-foxy-image-transport ros-foxy-message-filters \
    ros-foxy-tf2-ros ros-foxy-tf2-eigen \
    ros-foxy-rosbag2-storage-default-plugins \
    python3-colcon-common-extensions python3-rosdep python3-numpy \
    build-essential cmake git pkg-config wget \
    libeigen3-dev liblmdb-dev libopencv-dev libyaml-cpp-dev zlib1g-dev \
    libgtest-dev \
    gcc-11 g++-11 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-11 110 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-11 110 \
    && rm -rf /var/lib/apt/lists/*
RUN rosdep init || true && rosdep update || true

# cuVSLAM needs cmake >= 3.19; focal ships 3.16.
RUN wget -qO /tmp/cmake.sh \
      https://github.com/Kitware/CMake/releases/download/v3.27.9/cmake-3.27.9-linux-x86_64.sh && \
    sh /tmp/cmake.sh --skip-license --prefix=/usr/local && rm /tmp/cmake.sh && \
    cmake --version

# CUDA toolkit is mounted from the host at runtime (12.x validated; this laptop is 12.8).
ENV CUDA_HOME=/usr/local/cuda
ENV CUDA_PATH=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/targets/x86_64-linux/lib

COPY docker/entrypoint_host_cuvslam.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
WORKDIR /workspace
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]

[submodule "third_party/cuVSLAM"]
	path = third_party/cuVSLAM
	url = https://github.com/nvidia-isaac/cuVSLAM.git
	# The CUDA-10.2 port is applied as patch/cuvslam/*.patch at build time (with the
	# `patch` util, not git), so the working tree is intentionally a plain, modified
	# checkout. `ignore = all` keeps git status/pull from recursing into it — which
	# otherwise fails on boards where the submodule has no .git/modules metadata.
	ignore = all

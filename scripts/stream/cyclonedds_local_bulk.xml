<?xml version="1.0" encoding="UTF-8"?>
<!--
  CycloneDDS for BULK LOCAL transport: a publisher and a subscriber in the SAME container,
  moving ~190 MB/s of 1.585 MB camera frames. Used by the `logonly` service.

  NOT cyclonedds_lowlat.xml. That one is a point-to-point HOST<->BOARD link: it pins
  ${NET_IFACE} and an explicit ${PEER}, and with neither set it resolves to an empty
  interface and Cyclone refuses the domain with "does not match an available interface
  supporting udp". It also assumes the ethernet link, which does not exist when the board is
  on WiFi.

  Here nothing leaves the machine, so bind to loopback and spend the budget on buffers.

  WHY THIS EXISTS AT ALL. With Foxy's default rmw (fastrtps, default socket buffers) the
  capture node published a clean 30 Hz - 150 sets per 5 s window, 66 us skew - and rosbag2
  recorded 6.1 Hz per camera. Four fifths of the frames were dropped in the topic path, with
  the disk only a quarter busy. Default buffers cannot hold 1.585 MB messages at 30 Hz.

  The socket sizes below are REQUESTS: the kernel caps them at net.core.rmem_max /
  wmem_max, so raise those to match or Cyclone silently gets less than it asked for.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <NetworkInterfaceAddress>lo</NetworkInterfaceAddress>
      <AllowMulticast>false</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
      <FragmentSize>65000B</FragmentSize>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers>
        <Peer address="localhost"/>
      </Peers>
    </Discovery>
    <Internal>
      <MinimumSocketReceiveBufferSize>32MB</MinimumSocketReceiveBufferSize>
      <MinimumSocketSendBufferSize>32MB</MinimumSocketSendBufferSize>
      <!-- writer history high-water: how much a slow reader may fall behind before the
           writer blocks. Small values here are what turn a transient stall into a dropped
           frame on a best_effort topic. -->
      <WhcHigh>16MB</WhcHigh>
    </Internal>
    <Tracing>
      <OutputFile>stderr</OutputFile>
      <Verbosity>warning</Verbosity>
    </Tracing>
  </Domain>
</CycloneDDS>

+// CUDA 10.2 ships libcu++ 1.0, which has no <cuda/std/array> (it provides only
+// atomic, cassert, cfloat, climits, cstddef, cstdint, type_traits, version).
+// DeviceArray is a minimal stand-in with the same aggregate layout and the subset
+// of the std::array interface cuNLS uses, usable from host and device.
+template <typename T, int N> struct DeviceArray {
+  T _elems[N];
+  __host__ __device__ T &operator[](int i) { return _elems[i]; }
+  __host__ __device__ constexpr const T &operator[](int i) const { return _elems[i]; }
+  __host__ __device__ constexpr int size() const { return N; }
+  __host__ __device__ T *data() { return _elems; }
+  __host__ __device__ constexpr const T *data() const { return _elems; }
+  __host__ __device__ T *begin() { return _elems; }
+  __host__ __device__ constexpr const T *begin() const { return _elems; }
+  __host__ __device__ T *end() { return _elems + N; }
+  __host__ __device__ constexpr const T *end() const { return _elems + N; }
+};
+
